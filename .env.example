# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (optional) ---
# Leave these blank/unset to keep running in local-only demo mode.
# Fill them in (in a .env.local file, not this one) to make the admin
# panel's product changes live for every visitor. Values come from
# Firebase Console > Project Settings > General > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Cloudinary (optional) ---
# Leave blank to keep pasting image URLs manually in the admin panel.
# Fill in to enable the "Upload" button for product images.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# --- AI shopping assistant (server-side only, never prefix with VITE_) ---
# Get a key at https://aistudio.google.com/apikey and also add it in
# Vercel > Project > Settings > Environment Variables.
# GEMINI_MODEL is optional (defaults to gemini-flash-latest).
# GEMINI_API_KEY=""
# GEMINI_MODEL=""
